<section class="panel exceptions"><h3>单据隔离</h3><div class="tablebox"><table><thead><tr><th>原件</th><th>原行</th><th>原因</th><th>原件键 / 摘要</th></tr></thead><tbody>{% for row in issues %}<tr><td>{{ row.source }}</td><td>{{ row.line }}</td><td>{{ label[row.code] }}</td><td>{% if row.fields is defined %}{{ row.fields.event|default(row.fields.reservation|default(row.fields.receipt|default('—'))) }}{% else %}<code title="{{ row.row_sha256 }}">{{ row.row_sha256[:12] }}</code>{% endif %}</td></tr>{% else %}<tr><td colspan="4">没有隔离记录。</td></tr>{% endfor %}</tbody></table></div></section>
