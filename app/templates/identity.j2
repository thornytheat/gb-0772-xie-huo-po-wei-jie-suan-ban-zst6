<h2>到达时预约状态</h2><div class="tablebox"><table><thead><tr><th>车辆代号</th><th>泊位</th><th>到达</th><th>关联状态</th><th>预约</th><th>预约原行</th></tr></thead><tbody>{% for row in report.identity.stays %}<tr><td><code>{{ row.vehicle[:12] }}</code></td><td>{{ row.berth }}</td><td>{{ local(row.start) }}</td><td>{{ label[row.association] }}</td><td>{{ row.booking.reservation if row.booking else '—' }}</td><td>{{ row.candidates|map(attribute='line')|join(', ') or '—' }}</td></tr>{% else %}<tr><td colspan="6">暂无待关联停靠。</td></tr>{% endfor %}</tbody></table></div>{% if report.identity.booking_issues %}{% set issues=report.identity.booking_issues %}{% include 'issues.j2' %}{% endif %}
