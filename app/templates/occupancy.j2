<h2>跨杆占位并集</h2><p>重叠去除 {{ report.occupancy.removed_overlap_minutes }} 分钟</p><div class="tablebox"><table><thead><tr><th>泊位</th><th>车辆代号</th><th>到达</th><th>离开</th><th>杆侧合计</th><th>重建分钟</th><th>检测行</th></tr></thead><tbody>{% for row in report.occupancy.stays %}<tr><td>{{ row.berth }}</td><td>{{ row.vehicle[:8] }}</td><td>{{ local(row.start) }}</td><td>{{ local(row.end) }}</td><td>{{ row.observed_minutes }}</td><td>{{ row.minutes }}</td><td>{{ row.detections|map(attribute='line')|join(', ') }}</td></tr>{% else %}<tr><td colspan="7">暂无杆侧占位。</td></tr>{% endfor %}</tbody></table></div>
<section class="panel exceptions"><h3>争议占位分钟</h3><div class="tablebox"><table><thead><tr><th>泊位</th><th>分钟</th><th>原因</th></tr></thead><tbody>{% for row in report.occupancy.disputes %}<tr><td>{{ row.berth }}</td><td>{{ local(row.at) }}</td><td>{{ label[row.code] }}</td></tr>{% else %}<tr><td colspan="3">无占位争议。</td></tr>{% endfor %}</tbody></table></div></section>
