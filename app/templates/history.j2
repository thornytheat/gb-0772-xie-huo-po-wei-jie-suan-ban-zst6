<h2>清算运行清单</h2><div class="tablebox"><table><thead><tr><th>留档编号</th><th>原件包</th><th>落档时间 UTC</th><th>耗时 ms</th></tr></thead><tbody>{% for item in history %}<tr><td><a href="/clearing/appeal?key={{ item.key }}">{{ item.key[:18] }}</a></td><td>{{ item.source }}</td><td>{{ item.created_utc }}</td><td>{{ item.elapsed_ms }}</td></tr>{% else %}<tr><td colspan="4">先运行一次清算。</td></tr>{% endfor %}</tbody></table></div>
