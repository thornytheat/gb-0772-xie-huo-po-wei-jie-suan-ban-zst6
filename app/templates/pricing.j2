<div class="card-heading"><h2>跨日费率分段</h2><label>实际停靠 <select id="stay-picker">{% for r in report.pricing.stays %}<option value="{{ loop.index0 }}">{{ r.berth }} · {{ local(r.start) }}</option>{% endfor %}</select></label></div>
{% for r in report.pricing.stays %}<div class="fee-path" data-fee-stop="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}><ol class="timeline fee-timeline">{% for s in r.segments %}<li class="{{ s.code }}"><time>{{ local(s.start) }}–{{ local(s.end)[-5:] }}</time><div><strong>{{ label[s.code] }}</strong><p>{{ s.minutes }} 分钟 · {{ yuan(s.rate_cents) }}/分</p></div><b>{{ yuan(s.cents) }}</b></li>{% endfor %}</ol><section class="panel fee-summary"><h3>停靠核价</h3><dl><dt>泊位</dt><dd>{{ r.berth }}</dd><dt>预约</dt><dd>{{ label[r.association] }}</dd><dt>在位</dt><dd>{{ r.minutes }} 分钟</dd><dt>应收</dt><dd>{{ yuan(r.due_cents) }}</dd></dl><p>检测行 {{ r.detections|map(attribute='line')|join(', ') }}</p></section></div>{% else %}<p>暂无可核价停靠。</p>{% endfor %}
